<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.possystem.controller.InventoryController">

    <top>
        <VBox spacing="12">
            <padding><Insets top="16" right="18" bottom="10" left="18"/></padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Inventory Management" styleClass="page-title"/>
                <Region/>
                <Label fx:id="lowStockLabel" styleClass="stats-pill"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="card-box">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <TextField fx:id="skuField" promptText="SKU (e.g. COF-03)" prefWidth="115"/>
                <TextField fx:id="nameField" promptText="Product Name"/>
                <ComboBox fx:id="categoryBox" prefWidth="120"/>
                <TextField fx:id="priceField" promptText="Price ($)" prefWidth="85"/>
                <TextField fx:id="stockField" promptText="Initial Stock" prefWidth="95"/>
                <Button text="Add Product" onAction="#handleAddProduct" styleClass="primary-btn"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="inventoryTable">
            <BorderPane.margin><Insets top="4" right="18" bottom="4" left="18"/></BorderPane.margin>
            <columns>
                <TableColumn fx:id="skuCol" text="SKU" prefWidth="95"/>
                <TableColumn fx:id="nameCol" text="Product Name" prefWidth="240"/>
                <TableColumn fx:id="categoryCol" text="Category" prefWidth="120"/>
                <TableColumn fx:id="priceCol" text="Unit Price" prefWidth="100"/>
                <TableColumn fx:id="stockCol" text="In Stock" prefWidth="90"/>
                <TableColumn fx:id="alertCol" text="Status" prefWidth="110"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="10" right="18" bottom="16" left="18"/></padding>
            <TextField fx:id="restockAmountField" promptText="Qty to add" prefWidth="110"/>
            <Button text="Restock Selected" onAction="#handleRestock" styleClass="success-btn"/>
            <Button text="Delete Product" onAction="#handleDeleteProduct" styleClass="danger-btn"/>
        </HBox>
    </bottom>
</BorderPane>