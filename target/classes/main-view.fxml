<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.possystem.controller.MainController"
            styleClass="root-pane">

    <left>
        <VBox spacing="10" prefWidth="200" styleClass="sidebar">
            <padding><Insets top="20" right="12" bottom="20" left="12"/></padding>
            <Label text="STORE SUITE" styleClass="brand-title"/>
            <Separator/>
            <Button fx:id="posNavBtn" text="POS Checkout" onAction="#showPosView" maxWidth="Infinity" styleClass="nav-btn"/>
            <Button fx:id="inventoryNavBtn" text="Inventory" onAction="#showInventoryView" maxWidth="Infinity" styleClass="nav-btn"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"/>
    </center>
</BorderPane>